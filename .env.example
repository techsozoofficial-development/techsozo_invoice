# TechSozo Invoices — Environment Variables
# Phase 1: Local Demo Mode (No backend/Firebase connection required)
# Phase 2 (Future Migration): Firebase Spark Free Tier Web Public Configuration
# NOTE: Never store private Firebase Service Account keys or secret credentials here.

VITE_APP_NAME="TechSozo Invoices"
VITE_APP_ENV="demo"
VITE_STORAGE_MODE="local"

